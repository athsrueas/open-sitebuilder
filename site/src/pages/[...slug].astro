---
import project from '../project.json';
import { portfolioMarkup } from '../../../shared/render.js';
export function getStaticPaths() {
  return project.pages.map((page, index) => ({params: {slug: index === 0 ? undefined : page.slug}, props: {page}}));
}
const { page } = Astro.props;
const { css, html,features } = portfolioMarkup(project, page.id,{published:true});
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={project.description} /><title>{page.title} · {project.name}</title></head>
  <body>
    <style is:inline set:html={css}></style>
    <div id="portfolio" set:html={html}></div>
    {features.books && <script is:inline defer src="/folio-assets/page-flip.js"></script>}
    {features.books && <script is:inline defer src="/folio-assets/books.js"></script>}
    {features.motion && !features.books && <script is:inline defer src="/folio-assets/materials.js"></script>}
  </body>
</html>
