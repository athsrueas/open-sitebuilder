{
  "fonts": {
    "sans": {
      "label": "Classic sans \u00b7 Arial",
      "css": "Arial, Helvetica, sans-serif"
    },
    "humanist": {
      "label": "Humanist sans \u00b7 Trebuchet",
      "css": "\"Trebuchet MS\", Arial, sans-serif"
    },
    "verdana": {
      "label": "Readable sans \u00b7 Verdana",
      "css": "Verdana, Geneva, sans-serif"
    },
    "serif": {
      "label": "Book serif \u00b7 Georgia",
      "css": "Georgia, \"Times New Roman\", serif"
    },
    "classic": {
      "label": "Classic serif \u00b7 Times",
      "css": "\"Times New Roman\", Times, serif"
    },
    "mono": {
      "label": "Monospace \u00b7 Courier",
      "css": "\"Courier New\", Courier, monospace"
    }
  },
  "fields": {
    "background": {
      "label": "Background",
      "group": "Colors",
      "type": "color",
      "default": "#f5f1e9"
    },
    "ink": {
      "label": "Text color",
      "group": "Colors",
      "type": "color",
      "default": "#292d29"
    },
    "headingInk": {
      "label": "Heading color",
      "group": "Colors",
      "type": "color",
      "default": "#292d29"
    },
    "accent": {
      "label": "Accent color",
      "group": "Colors",
      "type": "color",
      "default": "#798269"
    },
    "bodyFont": {
      "label": "Body font",
      "group": "Typography",
      "type": "select",
      "default": "serif",
      "options": [
        "sans",
        "humanist",
        "verdana",
        "serif",
        "classic",
        "mono"
      ]
    },
    "headingFont": {
      "label": "Heading font",
      "group": "Typography",
      "type": "select",
      "default": "serif",
      "options": [
        "sans",
        "humanist",
        "verdana",
        "serif",
        "classic",
        "mono"
      ]
    },
    "bodySize": {
      "label": "Body size (px)",
      "group": "Typography",
      "type": "number",
      "default": 16,
      "min": 10,
      "max": 40,
      "step": 1
    },
    "headingSize": {
      "label": "Heading size (px)",
      "group": "Typography",
      "type": "number",
      "default": 32,
      "min": 16,
      "max": 100,
      "step": 1
    },
    "heroSize": {
      "label": "Introduction size (px)",
      "group": "Typography",
      "type": "number",
      "default": 82,
      "min": 24,
      "max": 160,
      "step": 1
    },
    "captionSize": {
      "label": "Caption size (px)",
      "group": "Typography",
      "type": "number",
      "default": 12,
      "min": 10,
      "max": 28,
      "step": 1
    },
    "lineHeight": {
      "label": "Line spacing",
      "group": "Typography",
      "type": "number",
      "default": 1.8,
      "min": 1,
      "max": 2.5,
      "step": 0.05
    },
    "letterSpacing": {
      "label": "Letter spacing (px)",
      "group": "Typography",
      "type": "number",
      "default": 0,
      "min": -2,
      "max": 8,
      "step": 0.1
    },
    "headingWeight": {
      "label": "Heading weight",
      "group": "Typography",
      "type": "select",
      "default": "400",
      "options": [
        "400",
        "500",
        "600",
        "700"
      ]
    },
    "align": {
      "label": "Text alignment",
      "group": "Layout",
      "type": "select",
      "default": "left",
      "options": [
        "left",
        "center",
        "right"
      ]
    },
    "contentWidth": {
      "label": "Page width (px)",
      "group": "Layout",
      "type": "number",
      "default": 1000,
      "min": 600,
      "max": 1800,
      "step": 1,
      "siteOnly": true
    },
    "blockGap": {
      "label": "Space after block (px)",
      "group": "Layout",
      "type": "number",
      "default": 90,
      "min": 0,
      "max": 240,
      "step": 1
    },
    "padding": {
      "label": "Block padding (px)",
      "group": "Layout",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1
    },
    "radius": {
      "label": "Image corners (px)",
      "group": "Layout",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 80,
      "step": 1
    },
    "galleryColumns": {
      "label": "Gallery columns",
      "group": "Layout",
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 4,
      "step": 1
    },
    "imageHeight": {
      "label": "Gallery image height (px)",
      "group": "Layout",
      "type": "number",
      "default": 400,
      "min": 160,
      "max": 900,
      "step": 1
    },
    "gridGap": {
      "label": "Grid spacing (px)",
      "group": "Layout",
      "type": "number",
      "default": 22,
      "min": 0,
      "max": 100,
      "step": 1
    }
  },
